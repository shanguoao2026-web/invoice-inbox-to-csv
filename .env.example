# Optional LLM fill-in (--llm). Leave these unset for the default heuristic parser.
# Tests never read this file and never call the network.

# Recommended: SpaceXAI, served by the xAI API (OpenAI-compatible).
# Create a key at https://console.x.ai
XAI_API_KEY=
INVOICE_LLM_BASE_URL=https://api.x.ai/v1
INVOICE_LLM_MODEL=grok-4.7

# Or any other OpenAI-compatible provider.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# INVOICE_LLM_MODEL=gpt-4o-mini

# Force a specific key when more than one of the variables above is set.
# INVOICE_LLM_API_KEY=
